  "cards": [
    {
      "dot": "cyan",
      "title": "Implemented (current HEAD) -- B0 through B4",
      "items": [
        "AuthN: email magic-link, API tokens, self-hosted bootstrap (B0.1)",
        "Organizations/tenants: membership, roles, invitations (B0.2)",
        "AuthZ: require_role() swept across all 157 mutating routes (B0.3)",
        "CSRF folded into that same sweep + the /auth/verify login-CSRF fix (B0.4)",
        "Rate limiting on named abuse-sensitive auth/org/token routes (B0.5)",
        "Mandatory ephemeral-container sandboxing for tenant PROJECT.yaml commands (B0.6)",
        "Encrypted org-scoped secret store + transcript/log redaction (B0.7)",
        "GET-route cross-org read isolation: require_read_role() + list filtering (B1.1)",
        "SSRF guard on tenant health-check URLs, AUTH_MODE=required only (B1.2)",
        "releases._next_version() concurrency race fixed with real thread evidence (B2.1)",
        "GitHub App JWT signing + installation-token minting + HMAC webhook (B3.1)",
        "GET /health readiness endpoint, fails closed on a real DB check (B3.2)",
        "Webhook-driven PR/CI status ingestion, read-only supplementary signal (B4.1-B4.3)",
        "pytest bumped to 9.x, verified with a real clean full-suite run (B4.0)",
        "AUTH_MODE=none: zero new surface, the permanent self-hosted default (ADR-004)"
      ]
    },
    {
      "dot": "amber",
      "title": "Known, explicitly deferred residual gaps",
      "items": [
        "Registering a real GitHub App on github.com is unbuilt -- needs a human GitHub account (B3.1 residual)",
        "Webhook PR/CI data is read-only/supplementary -- not wired into any merge/gate decision yet (B4 residual)",
        "Dashboard's running-sandbox/cleanup-pending counts stay unfiltered aggregate counts (B1.1 residual, low severity)"
      ]
    }
  ]

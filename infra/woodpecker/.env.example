# Copy to .env locally, chmod 600, NEVER commit real credentials.
# Configure HTTPS routing to the host's 127.0.0.1:8179 listener first.
CI_HTTP_PORT=8179
# Loopback-only until a dedicated runner and private VPN route are verified.
CI_GRPC_BIND_IP=127.0.0.1
WOODPECKER_HOST=https://ci.example.com
WOODPECKER_GITHUB_CLIENT=REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID
WOODPECKER_GITHUB_SECRET=REPLACE_WITH_GITHUB_OAUTH_CLIENT_SECRET
WOODPECKER_AGENT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
WOODPECKER_ADMIN=hungtranbkit
WOODPECKER_REPO_OWNERS=hungtranbkit
WOODPECKER_OPEN=false

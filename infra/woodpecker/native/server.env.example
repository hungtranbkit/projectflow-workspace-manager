# Non-secret TEMPLATE. Install script never creates server.env automatically.
# Copy to ~/.config/projectflow-woodpecker/server.env ONLY after DNS + OAuth exist.
# chmod 600 server.env; never commit, print, or transmit real secrets.
WOODPECKER_HOST=https://ci.example.com
WOODPECKER_GITHUB=true
WOODPECKER_GITHUB_CLIENT=REPLACE_WITH_ACTUAL_GITHUB_OAUTH_CLIENT
WOODPECKER_GITHUB_SECRET=REPLACE_WITH_ACTUAL_GITHUB_OAUTH_SECRET
WOODPECKER_GITHUB_PUBLIC_ONLY=true
WOODPECKER_ADMIN=hungtranbkit
WOODPECKER_REPO_OWNERS=hungtranbkit
WOODPECKER_OPEN=false
WOODPECKER_AGENT_SECRET=REPLACE_WITH_64_HEX_CHAR_SECRET
WOODPECKER_GRPC_SECRET=REPLACE_WITH_ANOTHER_64_HEX_CHAR_SECRET
WOODPECKER_FORCE_IGNORE_SERVICE_FAILURE=false
